fn isodd(v num) num {
    if v - 2 {
        let r = v / 2;
        if v - (r * 2){
            return 1; // is odd
        }
        return 0; // is even
    } else {
        return 0;
    }
}

let mut idx = 1;
let maxidx = 10;

while maxidx - idx {
    if isodd(idx) {
        print(idx + "\n");
    }
    idx = idx + 1;
}

exit(69);