let prev = 0;
let curr = 1;

fn fibonaccistring(prev num curr num steps num) str {
    if steps {
        let x = curr + prev;
        return x + " " + fibonaccistring(curr, x, steps - 1);
    } else {
        return "";
    }
}

let end = prev + " " + curr + " " + fibonaccistring(prev, curr, 10);

print("Sequence : " + end + "\n");

exit(69);